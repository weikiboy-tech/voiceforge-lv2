        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 44 ; lv2:symbol "exp_enabled" ; lv2:name "Expander" ;
          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 45 ; lv2:symbol "exp_threshold" ; lv2:name "Expander Threshold" ;
          lv2:default -48 ; lv2:minimum -80 ; lv2:maximum -12 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 46 ; lv2:symbol "exp_ratio" ; lv2:name "Expander Ratio" ;
          lv2:default 2 ; lv2:minimum 1 ; lv2:maximum 6 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 47 ; lv2:symbol "exp_attack" ; lv2:name "Expander Attack" ;
          lv2:default 4 ; lv2:minimum 0.1 ; lv2:maximum 100 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 48 ; lv2:symbol "exp_release" ; lv2:name "Expander Release" ;
          lv2:default 140 ; lv2:minimum 10 ; lv2:maximum 1000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 49 ; lv2:symbol "exp_range" ; lv2:name "Expander Range" ;
          lv2:default 18 ; lv2:minimum 0 ; lv2:maximum 36 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
