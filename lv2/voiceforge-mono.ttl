          lv2:default 4200 ; lv2:minimum 20 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 28 ; lv2:symbol "eq_4_gain" ; lv2:name "EQ 4 Gain" ;
          lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 29 ; lv2:symbol "eq_4_q" ; lv2:name "EQ 4 Q" ;
          lv2:default 0.707 ; lv2:minimum 0.25 ; lv2:maximum 8 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 30 ; lv2:symbol "high_shelf_enabled" ; lv2:name "High Shelf Enabled" ;
          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 31 ; lv2:symbol "high_shelf_frequency" ; lv2:name "High Shelf Frequency" ;
          lv2:default 8000 ; lv2:minimum 20 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 32 ; lv2:symbol "high_shelf_gain" ; lv2:name "High Shelf Gain" ;
          lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 33 ; lv2:symbol "high_shelf_q" ; lv2:name "High Shelf Q" ;
          lv2:default 0.707 ; lv2:minimum 0.25 ; lv2:maximum 8 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 34 ; lv2:symbol "comp_enabled" ; lv2:name "Compressor" ;
          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 35 ; lv2:symbol "comp_threshold" ; lv2:name "Compressor Threshold" ;
          lv2:default -20 ; lv2:minimum -60 ; lv2:maximum 0 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 36 ; lv2:symbol "comp_ratio" ; lv2:name "Compressor Ratio" ;
          lv2:default 3 ; lv2:minimum 1 ; lv2:maximum 20 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 37 ; lv2:symbol "comp_attack" ; lv2:name "Compressor Attack" ;
          lv2:default 12 ; lv2:minimum 0.1 ; lv2:maximum 100 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 38 ; lv2:symbol "comp_release" ; lv2:name "Compressor Release" ;
          lv2:default 120 ; lv2:minimum 10 ; lv2:maximum 1000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 39 ; lv2:symbol "comp_knee" ; lv2:name "Compressor Knee" ;
          lv2:default 6 ; lv2:minimum 0 ; lv2:maximum 24 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 40 ; lv2:symbol "comp_makeup" ; lv2:name "Compressor Makeup" ;
          lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 24 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 41 ; lv2:symbol "comp_mix" ; lv2:name "Compressor Mix" ;
          lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 42 ; lv2:symbol "comp_auto_makeup" ; lv2:name "Compressor Auto Makeup" ;
