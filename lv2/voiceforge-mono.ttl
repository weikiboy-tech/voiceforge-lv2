          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 51 ; lv2:symbol "de_esser_frequency" ; lv2:name "De-Esser Frequency" ;
          lv2:default 6500 ; lv2:minimum 2000 ; lv2:maximum 14000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 52 ; lv2:symbol "de_esser_threshold" ; lv2:name "De-Esser Threshold" ;
          lv2:default -24 ; lv2:minimum -60 ; lv2:maximum 0 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 53 ; lv2:symbol "de_esser_ratio" ; lv2:name "De-Esser Ratio" ;
