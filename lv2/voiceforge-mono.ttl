@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix rsz: <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://weikiboy-tech.github.io/voiceforge-lv2/mono>
    a lv2:Plugin ;
    doap:name "VoiceForge LV2 (Mono)" ;
    doap:license <https://spdx.org/licenses/MIT.html> ;
    lv2:minorVersion 4 ;
    lv2:microVersion 1 ;
    lv2:optionalFeature urid:map ;
    lv2:extensionData state:interface ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
        [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "input_gain" ; lv2:name "Input Gain" ; lv2:default 0.0 ; lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "output_gain" ; lv2:name "Output Gain" ; lv2:default 0.0 ; lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "enabled" ; lv2:name "Enabled" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:designation lv2:enabled ; lv2:portProperty lv2:toggled ],
        [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency, lv2:integer ; units:unit units:frame ],
        [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "high_pass" ; lv2:name "High Pass" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 300.0 ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "limiter_enabled" ; lv2:name "Limiter" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "limiter_ceiling" ; lv2:name "Limiter Ceiling" ; lv2:default -1.0 ; lv2:minimum -12.0 ; lv2:maximum 0.0 ; units:unit units:db ],
        [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "limiter_reduction" ; lv2:name "Limiter Gain Reduction" ; lv2:minimum 0.0 ; lv2:maximum 900.0 ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 10 ; lv2:symbol "low_shelf_enabled" ; lv2:name "Low Shelf Enabled" ;
          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 11 ; lv2:symbol "low_shelf_frequency" ; lv2:name "Low Shelf Frequency" ;
          lv2:default 120 ; lv2:minimum 20 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 12 ; lv2:symbol "low_shelf_gain" ; lv2:name "Low Shelf Gain" ;
          lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 13 ; lv2:symbol "low_shelf_q" ; lv2:name "Low Shelf Q" ;
          lv2:default 0.707 ; lv2:minimum 0.25 ; lv2:maximum 8 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 14 ; lv2:symbol "eq_1_enabled" ; lv2:name "EQ 1 Enabled" ;
          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 15 ; lv2:symbol "eq_1_frequency" ; lv2:name "EQ 1 Frequency" ;
          lv2:default 250 ; lv2:minimum 20 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 16 ; lv2:symbol "eq_1_gain" ; lv2:name "EQ 1 Gain" ;
          lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 17 ; lv2:symbol "eq_1_q" ; lv2:name "EQ 1 Q" ;
          lv2:default 0.707 ; lv2:minimum 0.25 ; lv2:maximum 8 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 18 ; lv2:symbol "eq_2_enabled" ; lv2:name "EQ 2 Enabled" ;
          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 19 ; lv2:symbol "eq_2_frequency" ; lv2:name "EQ 2 Frequency" ;
          lv2:default 700 ; lv2:minimum 20 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 20 ; lv2:symbol "eq_2_gain" ; lv2:name "EQ 2 Gain" ;
          lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 21 ; lv2:symbol "eq_2_q" ; lv2:name "EQ 2 Q" ;
          lv2:default 0.707 ; lv2:minimum 0.25 ; lv2:maximum 8 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 22 ; lv2:symbol "eq_3_enabled" ; lv2:name "EQ 3 Enabled" ;
          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 23 ; lv2:symbol "eq_3_frequency" ; lv2:name "EQ 3 Frequency" ;
          lv2:default 1800 ; lv2:minimum 20 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 24 ; lv2:symbol "eq_3_gain" ; lv2:name "EQ 3 Gain" ;
          lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 25 ; lv2:symbol "eq_3_q" ; lv2:name "EQ 3 Q" ;
          lv2:default 0.707 ; lv2:minimum 0.25 ; lv2:maximum 8 ; lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 26 ; lv2:symbol "eq_4_enabled" ; lv2:name "EQ 4 Enabled" ;
