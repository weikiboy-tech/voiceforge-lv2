          lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional, lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 21 ; lv2:symbol "eq_2_frequency" ; lv2:name "EQ 2 Frequency" ;
          lv2:default 700 ; lv2:minimum 20 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 22 ; lv2:symbol "eq_2_gain" ; lv2:name "EQ 2 Gain" ;
