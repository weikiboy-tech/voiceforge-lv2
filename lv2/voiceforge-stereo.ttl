          lv2:default 8000 ; lv2:minimum 20 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 34 ; lv2:symbol "high_shelf_gain" ; lv2:name "High Shelf Gain" ;
          lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
